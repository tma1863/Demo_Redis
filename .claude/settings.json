{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(./src/**)",
      "Read(./pom.xml)",
      "Read(./docker-compose.yml)",
      "Read(./run.sh)",
      "Read(./.gitignore)",
      "Read(./.gitattribute*)",
      "Read(./.env.example)",
      "Read(./HELP.md)",
      "Read(./CLAUDE.md)",
      "Read(./.mvn/**)",
      "Read(./.claude/agents/**)",

      "Bash(./mvnw *)",
      "Bash(mvn *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)"
    ],
    "ask": [
      "Edit(./src/**)",
      "Edit(./pom.xml)",
      "Edit(./docker-compose.yml)",
      "Edit(./run.sh)",
      "Edit(./.gitignore)",
      "Edit(./.gitattribute*)",
      "Edit(./.env.example)",
      "Edit(./HELP.md)",

      "Bash(./run.sh*)",
      "Bash(git *)"
    ],
    "deny": [
      "Read(./.claude/settings.json)",
      "Read(./.env)",
      "Read(./src/main/resources/application.properties)",
      "Read(./secrets/**)",

      "Edit(./.claude/settings.json)",
      "Edit(./.env)",
      "Edit(./mvnw)",
      "Edit(./mvnw.cmd)",

      "Bash(rm *)",
      "Bash(sudo *)",
      "Bash(docker *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "denyWrite": [
        "~/"
      ],
      "allowWrite": [
        ".",
        "~/.m2/repository"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gcp",
        "~/.azure",
        "~/.gnupg"
      ],
      "allowRead": [
        "."
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "repo.maven.apache.org",
        "repo1.maven.org"
      ]
    }
  }
}
